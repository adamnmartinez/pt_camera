<?xml version="1.0" ?>
<sdf version="1.10">
    <world name="pt_world">
        <physics name="1ms" type="ignored">
            <max_step_size>0.001</max_step_size>
            <real_time_factor>1.0</real_time_factor>
        </physics>
        <plugin
            filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics">
        </plugin>
        <plugin
            filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands">
        </plugin>
        <plugin
            filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster">
        </plugin>

        <light type="directional" name="sun">
            <cast_shadows>true</cast_shadows>
            <pose>0 0 10 0 0 0</pose>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <attenuation>
                <range>1000</range>
                <constant>0.9</constant>
                <linear>0.01</linear>
                <quadratic>0.001</quadratic>
            </attenuation>
            <direction>-0.5 0.1 -0.9</direction>
        </light>

        <model name="ground_plane">
            <static>true</static>
            <link name="link">
                <collision name="collision">
                <geometry>
                    <plane>
                    <normal>0 0 1</normal>
                    </plane>
                </geometry>
                </collision>
                <visual name="visual">
                <geometry>
                    <plane>
                    <normal>0 0 1</normal>
                    <size>100 100</size>
                    </plane>
                </geometry>
                <material>
                    <ambient>0.8 0.8 0.8 1</ambient>
                    <diffuse>0.8 0.8 0.8 1</diffuse>
                    <specular>0.8 0.8 0.8 1</specular>
                </material>
                </visual>
            </link>
        </model>

        <model name="pt_camera">
            <pose relative_to='world'>0 0 0 0 0 0</pose>
            <link name="base">
                <pose relative_to='__model__'>0 0 0.25 0 0 0</pose>
                <inertial> 
                    <mass>1.14395</mass>
                    <inertia>
                        <ixx>0.095329</ixx>
                        <ixy>0</ixy>
                        <ixz>0</ixz>
                        <iyy>0.381317</iyy>
                        <iyz>0</iyz>
                        <izz>0.476646</izz>
                    </inertia>
                </inertial>
                <visual name='visual'>
                    <geometry>
                        <box>
                            <size>2.0 2.0 0.5</size>
                        </box>
                    </geometry>
                    <!--let's add color to our link-->
                    <material>
                        <ambient>0.0 0.0 1.0 1</ambient>
                        <diffuse>0.0 0.0 1.0 1</diffuse>
                        <specular>0.0 0.0 1.0 1</specular>
                    </material>
                </visual>
                <collision name='collision'>
                    <geometry>
                        <box>
                            <size>2.0 2.0 0.5</size>
                        </box>
                    </geometry>
                </collision>
            </link>
            <link name="servo_1">
                <pose relative_to='__model__'>0 0 1 0 0 0</pose>
                <inertial>
                    <mass>0.009</mass>
                    <inertia>
                        <ixx>0.016</ixx>
                        <ixy>0</ixy>
                        <ixz>0</ixz>
                        <iyy>0.016</iyy>
                        <iyz>0</iyz>
                        <izz>0.016</izz>
                    </inertia>
                </inertial>
                <visual name='visual'>
                    <geometry>
                        <box>
                            <size>1.0 1.0 1.0</size>
                        </box>
                    </geometry>
                    <!--let's add color to our link-->
                    <material>
                        <ambient>0.0 1 0.0 1</ambient>
                        <diffuse>0.0 1 0.0 1</diffuse>
                        <specular>0.0 1 0.0 1</specular>
                    </material>
                </visual>
            </link>
            <link name="servo_2">
                <pose relative_to='__model__'>0 0 2.5 0 0 0</pose>
                <inertial>
                    <mass>0.009</mass>
                    <inertia>
                        <ixx>0.016</ixx>
                        <ixy>0</ixy>
                        <ixz>0</ixz>
                        <iyy>0.016</iyy>
                        <iyz>0</iyz>
                        <izz>0.016</izz>
                    </inertia>
                </inertial>
                <visual name='visual'>
                    <geometry>
                        <box>
                            <size>1.0 1.0 1.0</size>
                        </box>
                    </geometry>
                    <!--let's add color to our link-->
                    <material>
                        <ambient>0.0 1 0.0 1</ambient>
                        <diffuse>0.0 1 0.0 1</diffuse>
                        <specular>0.0 1 0.0 1</specular>
                    </material>
                </visual>
            </link>
            <link name="bracket_1">
                <pose relative_to='__model__'>0.75 0 1.75 0 0 0</pose>
                <inertial>
                    <mass>0.1</mass>
                    <inertia>
                        <ixx>0.016</ixx>
                        <ixy>0</ixy>
                        <ixz>0</ixz>
                        <iyy>0.016</iyy>
                        <iyz>0</iyz>
                        <izz>0.016</izz>
                    </inertia>
                </inertial>
                <visual name='visual'>
                    <geometry>
                        <box>
                            <size>0.5 1.0 2.0</size>
                        </box>
                    </geometry>
                    <!--let's add color to our link-->
                    <material>
                        <ambient>0.0 0.0 1.0 1</ambient>
                        <diffuse>0.0 0.0 1.0 1</diffuse>
                        <specular>0.0 0.0 1.0 1</specular>
                    </material>
                </visual>
            </link>
            <link name="bracket_2">
                <pose relative_to='__model__'>0 0.75 3 0 0 1.57</pose>
                <inertial>
                    <mass>0.1</mass>
                    <inertia>
                        <ixx>0.016</ixx>
                        <ixy>0</ixy>
                        <ixz>0</ixz>
                        <iyy>0.016</iyy>
                        <iyz>0</iyz>
                        <izz>0.016</izz>
                    </inertia>
                </inertial>
                <visual name='visual'>
                    <geometry>
                        <box>
                            <size>0.5 1.0 1.0</size>
                        </box>
                    </geometry>
                    <!--let's add color to our link-->
                    <material>
                        <ambient>1.0 0.0 1.0 1</ambient>
                        <diffuse>1.0 0.0 1.0 1</diffuse>
                        <specular>1.0 0.0 1.0 1</specular>
                    </material>
                </visual>
            </link>
            <link name="camera">
                <pose relative_to='__model__'>0 1 3 0 0 1.57</pose>
                <inertial>
                    <mass>0.01</mass>
                    <inertia>
                        <ixx>0.016</ixx>
                        <ixy>0</ixy>
                        <ixz>0</ixz>
                        <iyy>0.016</iyy>
                        <iyz>0</iyz>
                        <izz>0.016</izz>
                    </inertia>
                </inertial>
                <visual name='visual'>
                    <geometry>
                        <sphere>
                            <radius>0.2</radius>
                        </sphere>
                    </geometry>
                    <material>
                        <ambient>1.0 0.5 1.0 1</ambient>
                        <diffuse>1.0 0.5 1.0 1</diffuse>
                        <specular>1.0 0.5 1.0 1</specular>
                    </material>
                </visual>
            </link>
            <joint name="servo_1_joint" type='revolute'>
                <pose relative_to='servo_1'/>
                <parent>base</parent>
                <child>servo_1</child>
                <axis>
                    <dynamics>
                        <damping>2.0</damping>
                        <friction>0.05</friction>
                    </dynamics>
                    <xyz expressed_in='__model__'>0 0 1</xyz> <!--can be defined as any frame or even arbitrary frames-->
                    <limit>
                        <lower>-1.57</lower>
                        <upper>1.57</upper>
                        <effort>10</effort>
                        <velocity>2.0</velocity>
                    </limit>
                </axis>
            </joint>
            <joint name="bracket_1_joint" type='fixed'>
                <pose relative_to='servo_1'/>
                <parent>servo_1</parent>
                <child>bracket_1</child>
            </joint>
            <joint name="servo_2_joint" type='revolute'>
                <pose relative_to='servo_2'/>
                <parent>bracket_1</parent>
                <child>servo_2</child>
                <axis>
                    <dynamics>
                        <damping>2.0</damping>
                        <friction>0.05</friction>
                    </dynamics>
                    <xyz expressed_in='__model__'>1 0 0</xyz> <!--can be defined as any frame or even arbitrary frames-->
                    <limit>
                        <lower>-0.78</lower>    
                        <upper>2.35</upper>
                        <effort>10</effort>
                        <velocity>5.0</velocity>
                    </limit>
                </axis>
            </joint>
            <joint name="bracket_2_joint" type='fixed'>
                <pose relative_to='servo_2'/>
                <parent>servo_2</parent>
                <child>bracket_2</child>
            </joint>
            <joint name="camera_joint" type='fixed'>
                <pose relative_to='bracket_2'/>
                <parent>bracket_2</parent>
                <child>camera</child>
            </joint>
            <plugin
                filename="gz-sim-joint-position-controller-system"
                name="gz::sim::systems::JointPositionController">
                <joint_name>servo_1_joint</joint_name>
                <joint_index>0</joint_index>
                <topic>cmd_yaw</topic>
            </plugin>
            <plugin
                filename="gz-sim-joint-position-controller-system"
                name="gz::sim::systems::JointPositionController">
                <joint_name>servo_2_joint</joint_name>
                <joint_index>0</joint_index>
                <topic>cmd_pitch</topic>
            </plugin>
            <!-- Moving Base-->
            <!-- Left -->
            <plugin filename="gz-sim-triggered-publisher-system"
                    name="gz::sim::systems::TriggeredPublisher">
                <input type="gz.msgs.Int32" topic="/keyboard/keypress">
                    <match field="data">16777234</match>
                </input>
                <output type="gz.msgs.Double" topic="/cmd_yaw">
                    data: 0.5
                </output>
            </plugin>
            <!-- Right-->
            <plugin filename="gz-sim-triggered-publisher-system"
                    name="gz::sim::systems::TriggeredPublisher">
                <input type="gz.msgs.Int32" topic="/keyboard/keypress">
                    <match field="data">16777236</match>
                </input>
                <output type="gz.msgs.Double" topic="/cmd_yaw">
                    data: -0.5
                </output>
            </plugin>
            <!-- Moving Pitch-->
            <!-- Up -->
            <plugin filename="gz-sim-triggered-publisher-system"
                    name="gz::sim::systems::TriggeredPublisher">
                <input type="gz.msgs.Int32" topic="/keyboard/keypress">
                    <match field="data">16777235</match>
                </input>
                <output type="gz.msgs.Double" topic="/cmd_pitch">
                    data: 0.5
                </output>
            </plugin>
            <!-- Down -->
            <plugin filename="gz-sim-triggered-publisher-system"
                    name="gz::sim::systems::TriggeredPublisher">
                <input type="gz.msgs.Int32" topic="/keyboard/keypress">
                    <match field="data">16777237</match>
                </input>
                <output type="gz.msgs.Double" topic="/cmd_pitch">
                    data: -0.5
                </output>
            </plugin>
        </model>
    </world>
</sdf>